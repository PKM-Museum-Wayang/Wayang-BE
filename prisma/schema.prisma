// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id        Int    @id @default(autoincrement())
  username  String @unique
  password  String
  kegiatan  Kegiatan[]
  logKelola LogKelola[]
}

model Golongan {
  id             Int    @id @default(autoincrement())
  namaGolongan   String
  tipeGolongan   String

  wayang Wayang[]

  @@unique([namaGolongan, tipeGolongan])
}

model Penyimpanan {
  id        Int    @id @default(autoincrement())
  namaKotak String

  wayang Wayang[]
  logPeminjaman   LogPeminjaman[]
}

model Wayang {
  id          Int      @id @default(autoincrement())
  noWayang    String   @unique
  nama        String
  daerah      String?
  gaya        String?
  cerita      String?  @db.Text
  deskripsi   String?  @db.Text
  kondisi     String?

  golonganId  Int
  golongan    Golongan @relation(fields: [golonganId], references: [id])

  penyimpananId Int
  penyimpanan   Penyimpanan @relation(fields: [penyimpananId], references: [id])

  media         MediaWayang[]
  logKelola     LogKelola[]
  logPeminjaman LogPeminjaman[]

  relasi        Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MediaWayang {
  id          Int    @id @default(autoincrement())
  namaFile    String
  jenis       String
  keterangan  String?  @db.Text
  fileUrl     String

  wayangId Int
  wayang   Wayang @relation(fields: [wayangId], references: [id])
}

model Peminjam {
  id            Int    @id @default(autoincrement())
  namaPeminjam  String
  alamat        String
  noHp          String

  logPeminjaman LogPeminjaman[]
}

model LogPeminjaman {
  id              Int          @id @default(autoincrement())

  peminjamId      Int
  peminjam        Peminjam     @relation(fields: [peminjamId], references: [id])

  wayangId        Int?
  wayang          Wayang?      @relation(fields: [wayangId], references: [id])

  penyimpananId   Int?
  penyimpanan     Penyimpanan? @relation(fields: [penyimpananId], references: [id])

  tanggalPinjam   DateTime
  tanggalKembali  DateTime?
  keterangan     String?       @db.Text
  status          String

  @@index([peminjamId])
  @@index([wayangId])
  @@index([penyimpananId])
}

model LogKelola {
  id Int @id @default(autoincrement())

  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  wayangId Int
  wayang   Wayang @relation(fields: [wayangId], references: [id])

  pesan String? @db.Text

  @@index([adminId])
  @@index([wayangId])
}

model Kegiatan {
  id          Int      @id @default(autoincrement())
  nama        String
  deskripsi   String?  @db.Text
  tanggal     DateTime
  lokasi      String
  imageUrl    String?

  adminId     Int
  admin       Admin    @relation(fields: [adminId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}