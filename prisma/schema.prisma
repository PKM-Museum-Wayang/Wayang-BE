// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id    Int    @id @default(autoincrement())
  username  String
  password String
}

model Wayang {
  id          Int           @id @default(autoincrement())
  noWayang    String        @unique
  nama  String
  daerah      String?
  deskripsi   String?
  cerita      String?
  kondisi     String?

  media       MediaWayang[]
}

model MediaWayang {
  id          Int      @id @default(autoincrement())
  judul       String
  jenisMedia  String
  keterangan  String?
  fileUrl     String

  wayangId    Int
  wayang      Wayang   @relation(fields: [wayangId], references: [id])
}
