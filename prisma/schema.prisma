// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id        Int    @id @default(autoincrement())
  username  String @unique
  password  String
  kegiatan  Kegiatan[]
  logKelola LogKelola[]
}

model Golongan {
  id             Int    @id @default(autoincrement())
  namaGolongan   String
  tipeGolongan   String
  order          Int

  wayang Wayang[]

  @@unique([namaGolongan, tipeGolongan])
  @@index([tipeGolongan, order])
}

model Penyimpanan {
  id        Int    @id @default(autoincrement())
  namaKotak String

  wayang Wayang[]
  logPeminjaman   LogPeminjaman[]
}

model Wayang {
  id          Int      @id @default(autoincrement())
  noWayang    String   @unique
  nama        String
  daerah      String?
  gaya        String?
  cerita      String?  @db.Text
  deskripsi   String?  @db.Text
  kondisi     String?

  golonganId  Int
  golongan    Golongan @relation(fields: [golonganId], references: [id])

  penyimpananId Int
  penyimpanan   Penyimpanan @relation(fields: [penyimpananId], references: [id])

  media         MediaWayang[]
  logKelola     LogKelola[]
  logPeminjaman LogPeminjaman[]

  relasi        Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MediaWayang {
  id          Int    @id @default(autoincrement())
  namaFile    String
  jenis       String
  keterangan  String?  @db.Text
  fileUrl     String

  wayangId Int
  wayang   Wayang @relation(fields: [wayangId], references: [id])
}

model Peminjam {
  id            Int    @id @default(autoincrement())
  namaPeminjam  String
  alamat        String
  noHp          String

  logPeminjaman LogPeminjaman[]
}

model LogPeminjaman {
  id              Int          @id @default(autoincrement())

  peminjamId      Int
  peminjam        Peminjam     @relation(fields: [peminjamId], references: [id])

  wayangId        Int?
  wayang          Wayang?      @relation(fields: [wayangId], references: [id])

  penyimpananId   Int?
  penyimpanan     Penyimpanan? @relation(fields: [penyimpananId], references: [id])

  tanggalPinjam   DateTime
  tanggalKembali  DateTime?
  keterangan     String?       @db.Text
  status          String

  @@index([peminjamId])
  @@index([wayangId])
  @@index([penyimpananId])
}

model LogKelola {
  id Int @id @default(autoincrement())

  adminId Int
  admin   Admin @relation(fields: [adminId], references: [id])

  wayangId Int
  wayang   Wayang @relation(fields: [wayangId], references: [id])

  pesan String? @db.Text

  @@index([adminId])
  @@index([wayangId])
}

model Kegiatan {
  id          Int      @id @default(autoincrement())
  nama        String
  deskripsi   String?  @db.Text
  tanggal     DateTime
  lokasi      String

  adminId     Int
  admin       Admin    @relation(fields: [adminId], references: [id])

  gambar GambarKegiatan[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Singleton: constraint CHECK pada migrasi membatasi id hanya bernilai 1.
model Biografi {
  id                 Int      @id @default(1)
  fotoProfil         String   @db.VarChar(255)
  namaPemilikKoleksi String   @db.VarChar(255)
  email              String   @db.VarChar(255)
  phoneNumber        String   @db.VarChar(20)
  alamat             String   @db.Text
  hariMulai          String   @db.VarChar(10)
  hariSelesai        String   @db.VarChar(10)
  jamBuka            String   @db.VarChar(5)
  jamTutup           String   @db.VarChar(5)
  instagram          String?  @db.VarChar(2048)
  facebook           String?  @db.VarChar(2048)
  youtube            String?  @db.VarChar(2048)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PesanKontak {
  id          Int      @id @default(autoincrement())
  namaLengkap String   @db.VarChar(255)
  asal        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  noTelp      String   @db.VarChar(20)
  jenisTopik  String   @db.VarChar(20)
  pesan       String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt, id])
  @@index([jenisTopik])
}

model GambarKegiatan {
  id          Int   @id @default(autoincrement())
  fileUrl     String

  kegiatanId  Int
  kegiatan    Kegiatan @relation(fields: [kegiatanId], references: [id])
}